{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erf://schemas/ocr/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "media_id", "keyframe_id", "text", "confidence", "bbox"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ocr_id": {"type": "string", "description": "{keyframe_id}:ocr:{index:03d}"},
    "media_id": {"type": "string"},
    "keyframe_id": {"type": "string"},
    "text": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "bbox": {
      "type": "array",
      "description": "[x, y, w, h] normalised 0–1",
      "items": {"type": "number"},
      "minItems": 4, "maxItems": 4
    },
    "privacy_risk": {
      "type": ["string", "null"],
      "enum": ["credential", "key_or_token", "pii", null],
      "description": "Non-null triggers publicability='needs_review'"
    }
  }
}
