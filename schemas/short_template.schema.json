{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erf://schemas/short_template/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","template_id","name","platform","beat_structure","created_at_utc","created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "template_id": {"type": "string", "pattern": "^tmpl_[0-9a-f]{12}$"},
    "name": {"type": "string"},
    "platform": {"type": "string", "enum": ["tiktok","reels","youtube_shorts","longform","any"]},
    "duration_target_s": {"type": "number"},
    "caption_style": {"type": "string", "enum": ["lower_third","centre","top","none"], "default": "centre"},
    "tone_guidance": {"type": ["string","null"], "default": null},
    "beat_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role","duration_target_s"],
        "properties": {
          "role": {"type": "string"},
          "duration_target_s": {"type": "number"},
          "guidance": {"type": ["string","null"], "default": null}
        }
      }
    },
    "exemplar_beat_plan_ids": {"type": "array", "items": {"type": "string"}, "default": []},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "active": {"type": "boolean", "default": true}
  }
}
